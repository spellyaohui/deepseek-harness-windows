{
  "name": "deepseek-harness-windows",
  "version": "0.1.1-rc.7",
  "description": "Windows 桌面包装器：启动官方 DeepSeek Harness Web UI",
  "type": "module",
  "main": "src/main.js",
  "author": "deepseek-harness-windows",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "verify:upstream": "node scripts/verify-upstream-regressions.mjs",
    "dist:win": "electron-builder --win nsis zip --x64 --publish never"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.1-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-directory-picker-browse": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-models": "file:models-settings-plugin",
    "@deepseek-ai/dsh-code-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.1-rc.2",
    "@deepseek-ai/dsh-cpa-provider": "file:cpa-provider-plugin",
    "@deepseek-ai/dsh-desktop-settings": "file:desktop-settings-plugin",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-directory-picker-browse": "0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-markdown-export": "file:session-markdown-export-plugin",
    "@deepseek-ai/dsh-session-telemetry": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.1.1-rc.2",
    "@deepseek-ai/dsh-spill": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-workflow": "0.1.1-rc.2",
    "@nanmicoder/dsh-agent-teams": "file:agent-teams-plugin",
    "@nanmicoder/dsh-auto-mode": "0.1.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.deepseek.harness.windows",
    "productName": "DeepSeek Harness",
    "asar": false,
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "config/**/*",
      "assets/icon.ico",
      "assets/icon.png",
      "package.json",
      "LICENSE",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "DeepSeek-Harness-${version}-windows-${arch}.${ext}",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness",
      "runAfterFinish": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ]
    }
  },
  "allowScripts": {
    "@deepseek-ai/dsh-subprocess-local@0.1.1-rc.2": true,
    "@google/genai@1.52.0": true,
    "electron-winstaller@5.4.0": true,
    "koffi@3.1.6": true,
    "node-pty@1.2.0-beta.15": true,
    "protobufjs@7.6.5": true
  }
}
